# Disable directory browsing
Options -Indexes

# LiteSpeed / Apache Timeout Prevention for long running scripts
<IfModule Litespeed>
    RewriteEngine On
    RewriteRule .* - [E=noabort:1]
    RewriteRule .* - [E=noconntimeout:1]
</IfModule>
<IfModule mod_env.c>
    SetEnv noabort 1
    SetEnv noconntimeout 1
</IfModule>

# ----------------------------------------------------------------------
# Rewrite engine
# Mendukung DUA skenario:
# 1. Localhost subfolder: http://localhost/siakad/
# 2. Hosting root: https://smpistora.sch.id/
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Redirect trailing slash (kecuali folder nyata)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Lewati file/folder yang benar-benar ada di root
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Forward semua asset publik ke public/
    # Ini diperlukan di localhost subfolder (http://localhost/siakad/)
    # agar base_url('uploads/...') tetap bekerja meski file ada di public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
    RewriteRule ^(uploads|assets|img|css|js|tinymce)/(.*) public/$1/$2 [L,NC]

    # File statis di root public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(manifest\.json|robots\.txt|offline\.html|favicon\.ico|service-worker\.js)$ public/$1 [L,NC]

    # Semua request lain → index.php (CI4 front controller)
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

    # Pastikan Authorization header diteruskan ke PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

ServerSignature Off

# ----------------------------------------------------------------------
# PHP Settings
# ----------------------------------------------------------------------
<IfModule mod_php.c>
    php_value output_buffering 4096
    php_value max_input_vars 10000
    php_value upload_max_filesize 50M
    php_value post_max_size 55M
    php_value max_execution_time 300
</IfModule>
<IfModule mod_php8.c>
    php_value output_buffering 4096
    php_value max_input_vars 10000
    php_value upload_max_filesize 50M
    php_value post_max_size 55M
    php_value max_execution_time 300
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|zip|gz|bz2|rar|7z)$ no-gzip dont-vary
</IfModule>
