#--------------------------------------------------------------------
# Example Production Environment Configuration
# Copy this file to .env and update with your actual values
# Created: 23 Februari 2026
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# IMPORTANT: Set to 'production' for live server
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Your actual domain (with trailing slash)
app.baseURL = 'https://yourdomain.com/'

# Force HTTPS (IMPORTANT for production)
app.forceGlobalSecureRequests = true

# Disable CSP for now (enable if you configure it properly)
app.CSPEnabled = false

# Default locale
app.defaultLocale = 'id'

# Supported locales
app.supportedLocales = ['id']

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = your_database_user
database.default.password = your_secure_password
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

# CRITICAL: Disable debug in production (prevents SQL errors from showing)
database.default.DBDebug = false

database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Enable persistent connections for better performance
database.default.pConnect = false

# Enable strict mode
database.default.strictOn = true

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

# CRITICAL: Generate a new 32-character encryption key
# Use: php spark key:generate
# Or generate online: https://randomkeygen.com/
encryption.key = hex2bin:your-64-character-hex-key-here

# CSRF Protection
security.csrfProtection = cookie
security.tokenRandomize = false
security.tokenName = csrf_token_name
security.headerName = X-CSRF-TOKEN
security.cookieName = csrf_cookie_name
security.expires = 7200
security.regenerate = true
security.redirect = true

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# Session driver (file, database, redis, memcached)
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'

# Session cookie name
session.cookieName = 'ci_session'

# Session expiration (2 hours = 7200 seconds)
session.expiration = 7200

# Session save path
session.savePath = WRITEPATH . 'session'

# Match IP address (security feature)
session.matchIP = true

# Time to update session (5 minutes = 300 seconds)
session.timeToUpdate = 300

# Destroy old session on regenerate (security feature)
session.regenerateDestroy = true

#--------------------------------------------------------------------
# COOKIE
#--------------------------------------------------------------------

cookie.prefix = ''
cookie.expires = 0
cookie.path = '/'
cookie.domain = ''

# IMPORTANT: Enable for HTTPS only
cookie.secure = true

# Prevent JavaScript access to cookies
cookie.httponly = true

# SameSite attribute (Lax, Strict, None)
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------

# Log threshold
# 0 = Disables logging
# 1 = Emergency Messages
# 2 = Alert Messages
# 3 = Critical Messages
# 4 = Error Messages (recommended for production)
# 5 = Warning Messages
# 6 = Notice Messages
# 7 = Info Messages
# 8 = Debug Messages
# 9 = All Messages

# Production: 4 (errors only)
logger.threshold = 4

#--------------------------------------------------------------------
# CACHE
#--------------------------------------------------------------------

# Cache handler (file, redis, memcached, dummy)
cache.handler = file

# Cache TTL (1 hour = 3600 seconds)
cache.ttl = 3600

# Cache prefix
cache.prefix = 'cbt_'

# File cache path
cache.file.storePath = WRITEPATH . 'cache/'

#--------------------------------------------------------------------
# EMAIL (if using email features)
#--------------------------------------------------------------------

# Email protocol (mail, sendmail, smtp)
email.protocol = smtp

# SMTP settings (if using SMTP)
email.SMTPHost = smtp.gmail.com
email.SMTPUser = your-email@gmail.com
email.SMTPPass = your-app-password
email.SMTPPort = 587
email.SMTPCrypto = tls

# Email from
email.fromEmail = noreply@yourdomain.com
email.fromName = 'CBT System'

#--------------------------------------------------------------------
# HONEYPOT (spam protection)
#--------------------------------------------------------------------

honeypot.hidden = true
honeypot.label = 'Fill This Field'
honeypot.name = 'honeypot'
honeypot.template = '<label>{label}</label><input type="text" name="{name}" value=""/>'

#--------------------------------------------------------------------
# CORS (if using API)
#--------------------------------------------------------------------

cors.allowedOrigins = ['https://yourdomain.com']
cors.allowedOriginsPatterns = []
cors.allowedMethods = ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']
cors.allowedHeaders = ['Content-Type', 'Authorization', 'X-Requested-With']
cors.exposedHeaders = []
cors.maxAge = 7200
cors.supportsCredentials = false

#--------------------------------------------------------------------
# CUSTOM SETTINGS
#--------------------------------------------------------------------

# Application name
app.name = 'CBT System'

# Maintenance mode
app.maintenance = false

# Max upload size (in MB)
app.maxUploadSize = 10

# Allowed file types for upload
app.allowedFileTypes = 'jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx'

# Timezone
app.timezone = 'Asia/Jakarta'

#--------------------------------------------------------------------
# NOTES
#--------------------------------------------------------------------

# 1. Never commit .env file to version control
# 2. Keep .env.production.example as template
# 3. Generate new encryption key for each environment
# 4. Use strong database passwords
# 5. Enable HTTPS in production
# 6. Set proper file permissions (644 for .env)
# 7. Backup .env file securely
# 8. Rotate encryption keys periodically
# 9. Monitor logs regularly
# 10. Keep dependencies updated

