# ==============================================================================
# CodeIgniter 4 Core & Dependencies
# ==============================================================================
/vendor/
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
!/writable/cache/index.html
!/writable/cache/.gitkeep
!/writable/debugbar/index.html
!/writable/logs/index.html
!/writable/session/index.html
!/writable/uploads/index.html

# ==============================================================================
# Environment & Secrets (NEVER COMMIT!)
# ==============================================================================
.env
.env.backup
.env.local
.env.test.local

# License Security Files & Emergency Tools
/writable/.install_id
/writable/.production_mode
/generate_hash.php

# Developer mode marker (Local Dev Only)
.dev_mode

# ==============================================================================
# Testing & Build Artifacts
# ==============================================================================
/build/
.phpunit.cache/
phpunit.result.cache

# ==============================================================================
# Public Uploads (User Data & Generated Artifacts)
# ==============================================================================
public/uploads/backups/
public/uploads/signature/*
!public/uploads/signature/.gitkeep
!public/uploads/signature/index.html
public/uploads/tests_signature_tmp/

# Database Dumps
*.sql

# ==============================================================================
# IDEs, Editors & Operating System
# ==============================================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db

# Logs & Temporary Files
*.log
*.tmp
*.temp
*.bak
*.backup
*~
error_log
php_errors.log

# ==============================================================================
# Sub-Applications & External Repositories (Independent Standalone Apps)
# ==============================================================================
/bayaran/
/cbtku/
/bridge/

# ==============================================================================
# AI Agent Workspaces, Tooling & Local Docs
# ==============================================================================
/docs/
/prd/
/rekap-file-md/
/scratch/
/agent/
/.agents/
/AGENT.md
/.claude/
/.qoder/
/.kiro/
.kiro
/.antigravitycli/
/.cursorrules
/.clinerules
/skills-lock.json
/log_Cpanel/
/ai-context/
