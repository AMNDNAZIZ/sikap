# CodeIgniter 4
/vendor/
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
/writable/debugbar/*
!/writable/cache/index.html
!/writable/cache/.gitkeep
!/writable/debugbar/index.html
!/writable/logs/index.html
!/writable/session/index.html
!/writable/uploads/index.html


# Environment files
.env
.env.backup

# License Security Files (CRITICAL - DO NOT COMMIT!)
/writable/.install_id
/writable/.production_mode

# Emergency tools (NEVER commit these!)
/generate_hash.php

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Backup files
*.bak
*.backup
*~

# Temporary files
*.tmp
*.temp

# Backup uploads
public/uploads/backups/

# Docs folder
docs/

# Database dumps
*.sql

# Local production / development directories
/prd/
/docs/
/.antigravitycli/
/.cursorrules
/.clinerules
/.kiro/
.kiro
/.agents
/AGENT.md

# External standalone apps / sub-repos (reference only, do not track in siakad)
/bayaran/
/cbtku/
/bridge/

# Developer mode marker — hanya ada di PC developer, TIDAK untuk production/client
.dev_mode
/build/

# AI agent skills & lockfiles
/.claude/
/.qoder/
/agent/
/skills-lock.json
/log_Cpanel/
/ai-context/

# Local test credentials and sensitive scratch files (NEVER commit these!)
/scratch/*.local.php
/scratch/*_local.php
.env.test.local
